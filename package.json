    "dotenv": "17.4.2",
    "grammy": "1.45.1",
    "node-cron": "4.6.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
